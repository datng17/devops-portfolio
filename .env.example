# AWS ECR registry: <account-id>.dkr.ecr.<region>.amazonaws.com
REGISTRY=119640367180.dkr.ecr.us-east-1.amazonaws.com
TAG=latest
AWS_REGION=us-east-1

# Database (app container)
DB_HOST=mysql
DB_USER=appuser
DB_PASS=changeme
DB_NAME=appdb

# Scripts
S3_BUCKET=s3://my-devops-backups/mysql
RETAIN_DAYS=7
APP_BASE_URL=https://app.example.com
