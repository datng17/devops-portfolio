# AWS ECR registry: <account-id>.dkr.ecr.<region>.amazonaws.com
REGISTRY=119640367180.dkr.ecr.us-east-1.amazonaws.com
TAG=latest
AWS_REGION=us-east-1

# Database (app container)
DB_HOST=mysql
DB_USER=appuser
DB_PASS=changeme
DB_NAME=appdb

# Scripts
S3_BUCKET=s3://devops-backups-180/mysql
RETAIN_DAYS=7
APP_BASE_URL=https://test.name.vn

# TLS / Let's Encrypt (automatic HTTPS)
# TLS_DOMAIN must be a real FQDN with an A record pointing to this host's
# public IP, and ports 80+443 must be reachable from the internet.
TLS_DOMAIN=test.name.vn
TLS_EMAIL=datng416@gmail.com
# Set TLS_STAGING=1 while testing to avoid Let's Encrypt rate limits
# (staging certs are untrusted). Set to 0 for real, trusted certs.
TLS_STAGING=0
