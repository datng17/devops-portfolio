# AWS ECR registry: <account-id>.dkr.ecr.<region>.amazonaws.com
REGISTRY=119640367180.dkr.ecr.us-east-1.amazonaws.com
TAG=latest
AWS_REGION=us-east-1

# Database (app container)
DB_HOST=mysql
DB_USER=appuser
DB_PASS=letmein12345
DB_NAME=appdb

# Scripts
S3_BUCKET=s3://devops-backups-180/mysql
RETAIN_DAYS=7
APP_BASE_URL=https://portfolio.dev

# Cloudflare Tunnel (automatic HTTPS — TLS terminated at the Cloudflare edge)
# Create a tunnel in the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> Create a tunnel -> Cloudflared), add a public
# hostname that routes to the origin http://nginx:80, and paste the tunnel
# token below. The token is all cloudflared needs — no domain, email, certs,
# or open inbound ports. Keep this value secret.
CLOUDFLARE_TUNNEL_TOKEN=6d7859bb-edaf-47bf-b2f7-7fba96c1a487
